  },
  "dependencies": {
    "@prisma/client": "^6.8.0",
    "next": "^16.3.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "prisma": "^6.8.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
