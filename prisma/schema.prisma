generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique @db.VarChar(191)
  name          String         @db.VarChar(191)
  description   String         @db.Text
  pricePaise    Int
  oldPricePaise Int?
  active        Boolean        @default(false)
  isNew         Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  variants      Variant[]
  images        ProductImage[]
  categories    ProductCategory[]

  @@index([active, deletedAt, createdAt])
}

model Variant {
  id         String      @id @default(cuid())
  sku        String      @unique @db.VarChar(191)
  productId  String
  size       String      @db.VarChar(32)
  color      String      @db.VarChar(32)
  stock      Int         @default(0)
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@unique([productId, size, color])
  @@index([size, color, active, stock])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String  @db.VarChar(2048)
  alt       String  @db.VarChar(191)
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
}

model Category {
  id       String            @id @default(cuid())
  slug     String            @unique @db.VarChar(191)
  name     String            @db.VarChar(191)
  products ProductCategory[]
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model Customer {
  id        String    @id @default(cuid())
  email     String    @unique @db.VarChar(191)
  name      String?   @db.VarChar(191)
  phone     String?   @db.VarChar(32)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  addresses Address[]
  orders    Order[]
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  fullName   String   @db.VarChar(191)
  phone      String   @db.VarChar(32)
  line1      String   @db.VarChar(191)
  line2      String?  @db.VarChar(191)
  city       String   @db.VarChar(191)
  state      String   @db.VarChar(191)
  pinCode    String   @db.VarChar(6)
  country    String   @default("IN") @db.Char(2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Order {
  id               String        @id @default(cuid())
  number           String        @unique @db.VarChar(191)
  idempotencyKey   String        @unique @db.VarChar(191)
  customerId       String?
  email            String        @db.VarChar(191)
  status           OrderStatus   @default(PENDING)
  currency         String        @default("INR") @db.Char(3)
  subtotalPaise    Int
  shippingPaise    Int           @default(0)
  discountPaise    Int           @default(0)
  totalPaise       Int
  deliveryAddress Json
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payments         Payment[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  variantId      String
  productName    String  @db.VarChar(191)
  sku            String  @db.VarChar(191)
  size           String  @db.VarChar(32)
  color          String  @db.VarChar(32)
  quantity       Int
  unitPricePaise Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant        Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amountPaise     Int
  providerOrderId String?       @unique @db.VarChar(191)
  providerPaymentId String?     @unique @db.VarChar(191)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
}
